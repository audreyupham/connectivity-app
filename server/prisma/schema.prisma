generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Contact {
  id               Int      @id @default(autoincrement())
  name             String
  generalNotes     String?
  timestampedNotes Note[]
  userId           Int
  user             User @relation(fields: [userId], references: [id])
}

model Note {
  id        Int      @id @default(autoincrement())
  timestamp DateTime @default(now())
  text      String
  contactId Int
  contact   Contact @relation(fields: [contactId], references: [id])
}

model User {
  id            Int     @id @default(autoincrement())
  email         String  @unique
  password      String
  name          String
  resetToken    String?   // temporary token for password resets
  resetExpires  DateTime? // expiration time (optional)
  
  contacts      Contact[]
}