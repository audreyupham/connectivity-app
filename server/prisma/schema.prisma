generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


model Contact {
  id               Int      @id @default(autoincrement())
  name             String
  generalNotes     String?
  timestampedNotes Note[]
}

model Note {
  id        Int      @id @default(autoincrement())
  timestamp DateTime @default(now())
  text      String
  contact   Contact  @relation(fields: [contactId], references: [id])
  contactId Int
}
